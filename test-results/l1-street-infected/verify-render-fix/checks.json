{
  "target": "E19",
  "epics": [
    "E19"
  ],
  "pattern": "@(?:E19)(?:-AC\\d+)?(?=\\s|$)|@smoke(?=\\s|$)",
  "checks": [
    {
      "command": [
        "npm",
        "run",
        "typecheck"
      ],
      "exitCode": 0
    },
    {
      "command": [
        "npm",
        "run",
        "lint"
      ],
      "exitCode": 0
    },
    {
      "command": [
        "npm",
        "run",
        "build"
      ],
      "exitCode": 0
    },
    {
      "command": [
        "sh",
        "tools/sim-lock.sh",
        "npx",
        "vitest",
        "run",
        "-t",
        "@(?:E19)(?:-AC\\d+)?(?=\\s|$)|@smoke(?=\\s|$)",
        "--maxWorkers=1",
        "--reporter=default",
        "--reporter=json",
        "--outputFile=test-results/epics/E19/vitest.json"
      ],
      "exitCode": 1
    }
  ]
}
