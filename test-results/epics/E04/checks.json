{
  "target": "E04",
  "epics": [
    "E04"
  ],
  "pattern": "@(?:E04)(?:-AC\\d+)?(?=\\s|$)|@smoke(?=\\s|$)",
  "checks": [
    {
      "command": [
        "npm",
        "run",
        "typecheck"
      ],
      "exitCode": 0
    },
    {
      "command": [
        "npm",
        "run",
        "lint"
      ],
      "exitCode": 0
    },
    {
      "command": [
        "npm",
        "run",
        "build"
      ],
      "exitCode": 0
    },
    {
      "command": [
        "npx",
        "vitest",
        "run",
        "-t",
        "@(?:E04)(?:-AC\\d+)?(?=\\s|$)|@smoke(?=\\s|$)",
        "--reporter=default",
        "--reporter=json",
        "--outputFile=test-results/epics/E04/vitest.json"
      ],
      "exitCode": 0
    },
    {
      "command": [
        "sh",
        "tools/e2e-lock.sh",
        "npx",
        "playwright",
        "test",
        "--grep",
        "@(?:E04)(?:-AC\\d+)?(?=\\s|$)|@smoke(?=\\s|$)"
      ],
      "exitCode": 0
    }
  ]
}
