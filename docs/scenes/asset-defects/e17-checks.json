{
  "target": "E17",
  "epics": [
    "E17"
  ],
  "pattern": "@(?:E17)(?:-AC\\d+)?(?=\\s|$)|@smoke(?=\\s|$)",
  "checks": [
    {
      "command": [
        "npm",
        "run",
        "typecheck"
      ],
      "exitCode": 0
    },
    {
      "command": [
        "npm",
        "run",
        "lint"
      ],
      "exitCode": 0
    },
    {
      "command": [
        "npm",
        "run",
        "build"
      ],
      "exitCode": 0
    },
    {
      "command": [
        "sh",
        "tools/remote/run.sh",
        "/Users/wesner/Workspace/minorincident/.claude/worktrees/asset-defects",
        "--pull",
        "test-results/epics/E17/vitest.json",
        "--",
        "npx",
        "vitest",
        "run",
        "-t",
        "@(?:E17)(?:-AC\\d+)?(?=\\s|$)|@smoke(?=\\s|$)",
        "--maxWorkers=1",
        "--reporter=default",
        "--reporter=json",
        "--outputFile=test-results/epics/E17/vitest.json"
      ],
      "exitCode": 0
    },
    {
      "command": [
        "sh",
        "tools/e2e-lock.sh",
        "npx",
        "playwright",
        "test",
        "--grep",
        "@(?:E17)(?:-AC\\d+)?(?=\\s|$)|@smoke(?=\\s|$)"
      ],
      "exitCode": 1
    }
  ]
}
