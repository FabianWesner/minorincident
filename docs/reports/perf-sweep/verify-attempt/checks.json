{
  "target": "E18",
  "epics": [
    "E18"
  ],
  "pattern": "@(?:E18)(?:-AC\\d+)?(?=\\s|$)|@smoke(?=\\s|$)",
  "checks": [
    {
      "command": [
        "npm",
        "run",
        "typecheck"
      ],
      "exitCode": 0
    },
    {
      "command": [
        "npm",
        "run",
        "lint"
      ],
      "exitCode": 0
    },
    {
      "command": [
        "sh",
        "tools/e2e-lock.sh",
        "npm",
        "run",
        "build"
      ],
      "exitCode": 0
    },
    {
      "command": [
        "sh",
        "tools/sim-lock.sh",
        "npx",
        "vitest",
        "run",
        "-t",
        "@(?:E18)(?:-AC\\d+)?(?=\\s|$)|@smoke(?=\\s|$)",
        "--maxWorkers=1",
        "--reporter=default",
        "--reporter=json",
        "--outputFile=test-results/epics/E18/vitest.json"
      ],
      "exitCode": 0
    },
    {
      "command": [
        "sh",
        "tools/e2e-lock.sh",
        "npx",
        "playwright",
        "test",
        "--grep",
        "@(?:E18)(?:-AC\\d+)?(?=\\s|$)|@smoke(?=\\s|$)",
        "--grep-invert",
        "@E18-AC08|@E18-AC09|WebGPU low tier parity|@phone-base",
        "--workers=2"
      ],
      "exitCode": 1
    },
    {
      "command": [
        "sh",
        "tools/e2e-lock.sh",
        "npx",
        "playwright",
        "test",
        "tests/perf/e18-desktop.spec.ts",
        "tests/perf/e18-devices.spec.ts",
        "tests/perf/horde-budget.spec.ts",
        "--project=chromium",
        "--workers=1"
      ],
      "exitCode": 1
    },
    {
      "command": [
        "sh",
        "tools/perf/quiet-run.sh",
        "npx",
        "playwright",
        "test",
        "tests/perf/phone-base.spec.ts",
        "--project=chromium",
        "--workers=1"
      ],
      "exitCode": 1
    }
  ]
}
