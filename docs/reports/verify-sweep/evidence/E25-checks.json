{
  "target": "E25",
  "epics": [
    "E25"
  ],
  "pattern": "@(?:E25)(?:-AC\\d+)?(?=\\s|$)|@smoke(?=\\s|$)",
  "browserOmitted": true,
  "checks": [
    {
      "command": [
        "npm",
        "run",
        "typecheck"
      ],
      "exitCode": 0
    },
    {
      "command": [
        "npm",
        "run",
        "lint"
      ],
      "exitCode": 0
    },
    {
      "command": [
        "sh",
        "tools/e2e-lock.sh",
        "npm",
        "run",
        "build"
      ],
      "exitCode": 0
    },
    {
      "command": [
        "sh",
        "tools/sim-lock.sh",
        "npx",
        "vitest",
        "run",
        "-t",
        "@(?:E25)(?:-AC\\d+)?(?=\\s|$)|@smoke(?=\\s|$)",
        "--maxWorkers=4",
        "--reporter=default",
        "--reporter=json",
        "--outputFile=test-results/epics/E25/vitest.json"
      ],
      "exitCode": 0
    },
    {
      "command": [
        "sh",
        "tools/e2e-lock.sh",
        "npx",
        "playwright",
        "test",
        "--grep",
        "@(?:E25)(?:-AC\\d+)?(?=\\s|$)|@smoke(?=\\s|$)",
        "--grep-invert",
        "T-E25-14",
        "--workers=1"
      ],
      "exitCode": null
    },
    {
      "command": [
        "sh",
        "tools/perf/quiet-run.sh",
        "npx",
        "playwright",
        "test",
        "tests/perf/e25-lighting.spec.ts",
        "tests/perf/e25-light-lab.spec.ts",
        "--project=chromium",
        "--workers=1"
      ],
      "exitCode": null
    }
  ]
}
