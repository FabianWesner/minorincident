diff --git a/tests/levels/aggro-diagnostic/l3.test.ts b/tests/levels/aggro-diagnostic/l3.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/levels/aggro-diagnostic/l3.test.ts
@@ -0,0 +1,10 @@
+import { test } from 'vitest';
+import { mkdirSync, writeFileSync } from 'node:fs';
+const reportDir = process.env.AGGRO_REPORT_DIR ?? 'test-results/aggro-tune';
+const record = (name: string, data: unknown) => { mkdirSync(reportDir, { recursive: true }); writeFileSync(`${reportDir}/${name}.json`, JSON.stringify(data, null, 2)); console.log(name, JSON.stringify(data)); };
+const seeds = [1, 2, 3];
+import { loadL3, runL3 } from '../../../tools/sim-runner/l3Bots';
+test('aggro diagnostic L3 seeds 1-3', async () => {
+ const runs = [];
+ for (const seed of seeds) { const {world, mission} = await loadL3(seed); try { const r = runL3(world, mission, 'complete', {seed, maxSeconds:600}); const gun = [...r.killDistances.gun].sort((a,b)=>a-b); runs.push({seed, outcome:r.outcome, seconds:r.simSeconds, deaths:r.deaths, gunMedian:gun[Math.floor(gun.length/2)], gun, s1:r.s1, squad:r.squad}); } finally { world.dispose(); } record('l3', runs); }
+}, 1800000);
