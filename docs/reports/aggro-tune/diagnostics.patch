diff --git a/tests/levels/aggro-diagnostic/l6.test.ts b/tests/levels/aggro-diagnostic/l6.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/levels/aggro-diagnostic/l6.test.ts
@@ -0,0 +1,10 @@
+import { test } from 'vitest';
+import { mkdirSync, writeFileSync } from 'node:fs';
+const reportDir = process.env.AGGRO_REPORT_DIR ?? 'test-results/aggro-tune';
+const record = (name: string, data: unknown) => { mkdirSync(reportDir, { recursive: true }); writeFileSync(`${reportDir}/${name}.json`, JSON.stringify(data, null, 2)); console.log(name, JSON.stringify(data)); };
+const seeds = [1, 2, 3];
+import { loadL6, runL6 } from '../../../tools/sim-runner/l6Bots';
+test('aggro diagnostic L6 seeds 1-3', async () => {
+ const runs = [];
+ for (const seed of seeds) for (const profile of ['complete', 'newbie'] as const) { const {world} = await loadL6(seed); try { const r = runL6(world, profile); runs.push({seed, profile, outcome:r.outcome, seconds:r.simSeconds, deaths:r.deaths, rescued:r.rescued, total:r.total, share:r.rescued/r.total}); } finally { world.dispose(); } record('l6', runs); }
+}, 1800000);
diff --git a/tests/levels/aggro-diagnostic/l7.test.ts b/tests/levels/aggro-diagnostic/l7.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/levels/aggro-diagnostic/l7.test.ts
@@ -0,0 +1,10 @@
+import { test } from 'vitest';
+import { mkdirSync, writeFileSync } from 'node:fs';
+const reportDir = process.env.AGGRO_REPORT_DIR ?? 'test-results/aggro-tune';
+const record = (name: string, data: unknown) => { mkdirSync(reportDir, { recursive: true }); writeFileSync(`${reportDir}/${name}.json`, JSON.stringify(data, null, 2)); console.log(name, JSON.stringify(data)); };
+const seeds = [1, 2, 3];
+import { runLevel } from '../../../tools/sim-runner/levels';
+test('aggro diagnostic L7 seeds 1-3', async () => {
+ const runs = [];
+ for (const seed of seeds) { let starting=0, boarded=0; const r = await runLevel('L7', 'complete', seed, 1200, 'auto', undefined, (world,result)=>{starting=world.l7Encounters!.state.roster.length;boarded=result.rescued;}); runs.push({seed, completed:r.completed, seconds:r.time, deaths:r.deaths, starting, boarded, share:boarded/starting}); record('l7', runs); }
+}, 1800000);
